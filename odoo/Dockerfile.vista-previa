# Vista previa de la tienda (módulo website_supricom_tienda) para un entorno de prueba en EasyPanel.
# Solo sirve archivos estáticos: no instala nada en Odoo. En EasyPanel: ruta de compilación /odoo
# y este archivo como Dockerfile (ver vista-previa/LEEME.md).
FROM nginx:1.27-alpine
COPY vista-previa.nginx.conf /etc/nginx/conf.d/default.conf
COPY vista-previa /usr/share/nginx/html/vista-previa
COPY website_supricom_tienda/static /usr/share/nginx/html/website_supricom_tienda/static
EXPOSE 80
